{
  // Gateway config: bind LAN for Render, no trustedProxies (Render does not
  // safely rebuild forwarded client headers, so let the gateway attribute the
  // direct peer instead of failing with proxy_attribution_required).
  gateway: {
    bind: "lan",
  },
  // MiniMax M3 via Cloudflare Worker relay (OpenAI-compatible)
  models: {
    providers: {
      minimax: {
        baseUrl: "https://minimax-m3-relay.h001-0f2.workers.dev/v1",
        apiKey: "${MINIMAX_RELAY_KEY}",
        api: "openai-completions",
        models: [
          {
            id: "MiniMax-M3",
            name: "MiniMax M3",
            input: ["text"],
            contextWindow: 200000,
            maxTokens: 32768,
          },
        ],
      },
    },
  },
  agents: {
    defaults: {
      model: {
        primary: "minimax/MiniMax-M3",
      },
    },
  },
}
