{
  // Gateway config: trust loopback proxy (Render's internal proxy reaches the
  // container over 127.0.0.1 with X-Forwarded-For) and enable the OpenAI
  // compatible chat completions endpoint.
  gateway: {
    bind: "lan",
    trustedProxies: ["127.0.0.1/32", "::1/128"],
    http: {
      endpoints: {
        chatCompletions: { enabled: true },
      },
    },
  },
  // MiniMax M3 via Cloudflare Worker relay (OpenAI-compatible)
  models: {
    providers: {
      minimax: {
        baseUrl: "https://minimax-m3-relay.h001-0f2.workers.dev/v1",
        apiKey: "${MINIMAX_RELAY_KEY}",
        api: "openai-completions",
        models: [
          {
            id: "MiniMax-M3",
            name: "MiniMax M3",
            input: ["text"],
            contextWindow: 200000,
            maxTokens: 32768,
          },
        ],
      },
    },
  },
  agents: {
    defaults: {
      model: {
        primary: "minimax/MiniMax-M3",
      },
    },
  },
}
